# Public configuration only. Never put private keys here.
VITE_EVENT_CONTRACT=
VITE_CHAIN_ID=0x14a34

# SERVER ONLY: never prefix these with VITE_.
# Hosted deployment: set DESIGN_PDF_KEY to the owner key from `npm run design:key`.
# Local dev/preview/start automatically use .secrets/design-book.key if this is blank.
DESIGN_PDF_KEY=
# Optional shared review code. Blank allows every PoC visitor to view the book.
DESIGN_ACCESS_CODE=
